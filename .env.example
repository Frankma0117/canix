# ===== Servidor =====
PORT=3000

# Zona horaria IANA (recordatorios, tareas, habitos)
TIMEZONE=America/Bogota

# ===== Inteligencia Artificial (compatible con OpenAI) =====
# Proveedor: openai | openrouter | groq | deepseek | otro-compatible
AI_PROVIDER=openai
# Modelo (depende del proveedor). Ej: gpt-4o-mini, gpt-5-mini, etc.
AI_MODEL=gpt-4o-mini
# Tu API key.
AI_API_KEY=
# Base URL para endpoints compatibles con OpenAI (proxies, OpenRouter, Groq...)
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1

# ===== Base de datos =====
# SQLite: un solo archivo local, no requiere servidor.
DB_PATH=./data/app.db

# ===== WhatsApp =====
# Nombre de la sesion de Baileys (carpeta dentro de auth_info/).
WA_SESSION=personal-agent

# ===== Panel admin =====
# Token para entrar al panel. Si lo dejas vacio, el servidor genera uno solo
# y lo guarda en auth_info/admin-token.txt (se imprime en consola al iniciar).
ADMIN_TOKEN=
