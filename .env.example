# ===== Servidor =====
PORT=3000

# Zona horaria IANA (recordatorios, tareas, habitos) - todo el bot (prompt del agente, scheduler,
# fechas en el panel) usa esta zona para "ahora"/"hoy", no cambia con el proveedor de IA ni con
# donde corra el servidor. Cambiala solo si de verdad NO estas en Colombia.
TIMEZONE=America/Bogota

# Hora 'HH:mm' (en TIMEZONE) a la que cada usuario recibe automaticamente su agenda del dia
# (rutinas, recordatorios y tareas de hoy ordenados, ver README "Agenda del dia").
MORNING_SUMMARY_TIME=06:30

# ===== Inteligencia Artificial (compatible con OpenAI) =====
# Proveedor: openai | openrouter | groq | deepseek | otro-compatible
AI_PROVIDER=openai
# Modelo (depende del proveedor). Ej: gpt-4o-mini, gpt-5-mini, etc.
AI_MODEL=gpt-4o-mini
# Tu API key.
AI_API_KEY=
# Base URL para endpoints compatibles con OpenAI (proxies, OpenRouter, Groq...)
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1
# Cuantos mensajes pasados (tuyos + del bot) se reenvian como contexto en cada llamada - el
# principal factor de cuantos tokens de entrada se gastan por mensaje. Mas bajo = mas barato pero
# con menos memoria de la conversacion reciente.
AI_HISTORY_TURNS=14

# ===== Base de datos =====
# SQLite: un solo archivo local, no requiere servidor.
DB_PATH=./data/app.db

# ===== WhatsApp =====
# Nombre de la sesion de Baileys (carpeta dentro de auth_info/).
WA_SESSION=personal-agent
# Indicativo de pais que se antepone a numeros "locales" (dados sin indicativo, ej. 3001234567)
# al guardar contactos o mandar mensajes - sin esto el numero queda incompleto y no se le puede
# escribir. Vacio = usar los numeros tal cual se den, sin completar nada.
DEFAULT_COUNTRY_CODE=57

# ===== Panel web =====
# Token del administrador para entrar al panel. Si lo dejas vacio, el servidor genera uno solo
# y lo guarda en auth_info/admin-token.txt (se imprime en consola al iniciar). Cada persona con
# acceso al bot (ver grant_access) recibe su propio token aleatorio por separado, generado
# automaticamente - solo el del administrador se puede fijar por env.
ADMIN_TOKEN=
# URL publica del panel (opcional, solo cosmetica) - si la defines, el mensaje de bienvenida que
# recibe alguien nuevo por WhatsApp incluye el enlace ademas de su token.
PANEL_URL=

# ===== Audio: transcripcion y respuesta por voz (100% local, sin IA/tokens) =====
# Transcribir notas de voz (Vosk). Descarga un modelo (ej. vosk-model-small-es-0.42, ~50MB) de
# https://alphacephei.com/vosk/models, descomprimelo y apunta esto a esa carpeta.
# Si no existe, la transcripcion simplemente queda desactivada (el bot te pide texto en su lugar).
VOSK_MODEL_PATH=./models/vosk-es

# Responder con nota de voz ademas de texto (Piper). Descarga el binario de
# https://github.com/rhasspy/piper/releases y una voz en espanol (.onnx + .onnx.json) de
# https://huggingface.co/rhasspy/piper-voices (ej. es_ES-davefx-medium).
# Si se dejan vacios, el bot responde solo en texto.
PIPER_BIN_PATH=
PIPER_VOICE_PATH=
