# ===== Servidor =====
PORT=3000

# Zona horaria IANA (recordatorios, tareas, habitos) - todo el bot (prompt del agente, scheduler,
# fechas en el panel) usa esta zona para "ahora"/"hoy", no cambia con el proveedor de IA ni con
# donde corra el servidor. Cambiala solo si de verdad NO estas en Colombia.
TIMEZONE=America/Bogota

# Ya no dispara ningun aviso propio - la agenda diaria automatica se quito (el bot ya no manda
# mensajes sin que se los pidan, ver README "Agenda del dia"). Se conserva solo como referencia
# horaria para DAILY_RESET_TIME mas abajo.
MORNING_SUMMARY_TIME=06:30

# Hora (0-23, en TIMEZONE) a partir de la cual completar la ultima tarea/rutina pendiente del dia
# dispara la despedida automatica de "buenas noches" (ver README "Buenos dias / buenas noches").
# Terminar todo mas temprano que esta hora NO dispara la despedida.
NIGHT_SUMMARY_AFTER_HOUR=18

# Dia y hora (en TIMEZONE) del resumen semanal automatico (rutinas cumplidas + tareas de una sola
# vez completadas/pendientes, ver README "Resumen semanal"). Dia: 0=domingo .. 6=sabado.
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_TIME=19:00

# ===== Inteligencia Artificial (compatible con OpenAI) =====
# Proveedor: openai | openrouter | groq | deepseek | otro-compatible
AI_PROVIDER=openai
# Modelo (depende del proveedor). Ej: gpt-4o-mini, gpt-5-mini, etc.
AI_MODEL=gpt-4o-mini
# Tu API key.
AI_API_KEY=
# Base URL para endpoints compatibles con OpenAI (proxies, OpenRouter, Groq...)
# OpenAI:      https://api.openai.com/v1
# OpenRouter:  https://openrouter.ai/api/v1
# Groq:        https://api.groq.com/openai/v1
AI_BASE_URL=https://api.openai.com/v1
# Cuantos mensajes pasados (tuyos + del bot) se reenvian como contexto en cada llamada - el
# principal factor de cuantos tokens de entrada se gastan por mensaje. Mas bajo = mas barato pero
# con menos memoria de la conversacion reciente.
AI_HISTORY_TURNS=14

# ===== Base de datos =====
# SQLite: un solo archivo local, no requiere servidor.
DB_PATH=./data/app.db

# ===== WhatsApp =====
# Nombre de la sesion de Baileys (carpeta dentro de auth_info/).
WA_SESSION=personal-agent
# Indicativo de pais que se antepone a numeros "locales" (dados sin indicativo, ej. 3001234567)
# al guardar contactos o mandar mensajes - sin esto el numero queda incompleto y no se le puede
# escribir. Vacio = usar los numeros tal cual se den, sin completar nada.
DEFAULT_COUNTRY_CODE=57

# Limite diario de mensajes PROACTIVOS (recordatorios, rutinas, resumen semanal - todo lo que el
# bot manda sin que se lo pidan en el momento). Ultima linea de defensa contra un bucle/error que
# mande un volumen inusual en un dia (ver whatsapp/send-guard.ts y README "Como evitar que WhatsApp
# bloquee/restrinja el numero"). Un numero recien vinculado arranca muy por debajo de esto (rampa de
# calentamiento automatica, sube sola en 14 dias) - este es el techo ya calentado. 0 = sin limite.
MAX_DAILY_PROACTIVE_MESSAGES=300

# Limite diario de mensajes EN FRIO (send_message a alguien que nunca le ha escrito al bot) -
# mucho mas bajo a proposito: es el patron que WhatsApp mas vigila. Sube con la misma rampa de
# calentamiento. 0 = sin limite (no recomendado).
MAX_DAILY_COLD_MESSAGES=20

# ===== Panel web =====
# Token del administrador para entrar al panel. Si lo dejas vacio, el servidor genera uno solo
# y lo guarda en auth_info/admin-token.txt (se imprime en consola al iniciar). Cada persona con
# acceso al bot (ver grant_access) recibe su propio token aleatorio por separado, generado
# automaticamente - solo el del administrador se puede fijar por env.
ADMIN_TOKEN=
# URL publica de este servidor (https). Antes solo cosmetica (el mensaje de bienvenida por
# WhatsApp incluye el enlace ademas del token) - ahora TAMBIEN necesaria para los recordatorios por
# llamada: Twilio la usa para avisarnos el estado real de cada llamada (ver
# src/server/twilio-webhook.ts). Sin ella, las llamadas igual se hacen, solo no se ve su estado
# mas alla de "processing".
PANEL_URL=

# ===== Audio: transcripcion y respuesta por voz (100% local, sin IA/tokens) =====
# Transcribir notas de voz (Vosk). Descarga un modelo (ej. vosk-model-small-es-0.42, ~50MB) de
# https://alphacephei.com/vosk/models, descomprimelo y apunta esto a esa carpeta.
# Si no existe, la transcripcion simplemente queda desactivada (el bot te pide texto en su lugar).
VOSK_MODEL_PATH=./models/vosk-es

# Responder por voz cuando te preguntan por voz (Piper). Descarga el binario de
# https://github.com/rhasspy/piper/releases y una voz en espanol (.onnx + .onnx.json) de
# https://huggingface.co/rhasspy/piper-voices (ej. es_ES-davefx-medium).
# Si se dejan vacios, el bot responde solo en texto.
PIPER_BIN_PATH=
PIPER_VOICE_PATH=
# Segunda voz opcional (femenina) - cada usuario elige cual usar con el comando/tool
# set_voice_gender ("quiero voz de mujer"). Si se deja vacio, todos usan PIPER_VOICE_PATH de arriba
# sin importar su preferencia. Busca una voz .onnx en espanol distinta a la de arriba.
PIPER_VOICE_PATH_FEMALE=

# ===== Fashion Mode (armario/outfits - modulo aislado, ver README "Fashion Mode") =====
# Interruptor general. En false, el bot se comporta exactamente igual que sin este modulo.
FASHION_MODE_ENABLED=false
FASHION_MAX_IMAGE_SIZE_MB=8

# Importar varias prendas de una vez mandando un PDF con fotos (en vez de foto por foto).
FASHION_MAX_PDF_SIZE_MB=15
FASHION_MAX_PDF_IMAGES=12

# DigitalOcean Spaces (S3-compatible) - guarda las fotos originales + miniaturas de las prendas.
# Confirma el endpoint/region exactos en tu panel de DO (Spaces > tu bucket > Settings).
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=cania-storage
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=

# Servicio local de vision (Python, ver /vision-service) - analiza fotos de prendas gratis y en tu
# propio servidor, sin ninguna API paga. Si no esta corriendo o falla, Fashion Mode simplemente te
# pide clasificar la prenda a mano - nunca bloquea ni rompe el flujo.
FASHION_VISION_SERVICE_URL=http://127.0.0.1:8008
FASHION_VISION_TIMEOUT_MS=15000
FASHION_VISION_MIN_CONFIDENCE=0.35

# ===== Recordatorios por llamada (Twilio Programmable Voice, ver /src/calls) =====
# Credenciales de tu cuenta de Twilio (console.twilio.com) - NUNCA las commitees, y nunca las
# imprimas en logs (ver src/calls/twilio-client.ts).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Numero de Twilio que se usa como caller ID (E.164, ej. +18023004379) - el origen de TODAS las
# llamadas, nunca configurable por un usuario.
TWILIO_PHONE_NUMBER=
# Cuantas veces se reintenta una llamada que fallo/no contestaron/ocupado antes de darla por
# fallida definitivamente, y cuantos minutos esperar entre intentos - cada intento es una llamada
# real que Twilio cobra, mantenlo bajo.
TWILIO_CALL_MAX_ATTEMPTS=3
TWILIO_CALL_RETRY_DELAY_MINUTES=5

# ===== Voz natural (Fish Audio, https://fish.audio) - extra de pago =====
# Solo se usa para quien tenga el permiso "Voz natural (IA)" (voice.premium); el resto (o si Fish
# falla) usa Piper local. Se cobra por caracter: respuestas mas largas que FISH_AUDIO_MAX_CHARS van
# como texto. Las voces son "reference_id" de la biblioteca de fish.audio (una por genero).
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_MALE=17ed67335f0145c9a850fddecd3c40e0
FISH_AUDIO_VOICE_FEMALE=e296306da5d449999f6e35c2b9f60aea
FISH_AUDIO_MAX_CHARS=700
FISH_AUDIO_TIMEOUT_MS=20000

# ===== fal.ai (imagenes) =====
# El bot NO genera imagenes (los stickers salen solo del paquete del admin). Reservado para
# generar assets del portal web a mano.
FAL_KEY=
