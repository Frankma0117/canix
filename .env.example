# Canix configuration. Copy to .env (deploy.sh does it on first run) and fill in the secrets.
# Paths are relative to the repository root. Never commit .env.

# ===== Server =====
PORT=3000

# IANA time zone for everything time-related (reminders, routines, agenda, portal dates). It does
# not depend on the AI provider or on where the server runs. Change it only if you are NOT in Colombia.
TIMEZONE=America/Bogota

# No longer sends anything by itself (the automatic morning agenda was removed); kept only as the
# reference time for DAILY_RESET_TIME below.
MORNING_SUMMARY_TIME=06:30

# Hour (0-23, in TIMEZONE) from which finishing the day's last pending task/routine triggers the
# "good night" farewell. Finishing everything earlier does not trigger it.
NIGHT_SUMMARY_AFTER_HOUR=18

# Day and time (in TIMEZONE) of the automatic weekly report. Day: 0=Sunday .. 6=Saturday.
WEEKLY_REPORT_DAY=0
WEEKLY_REPORT_TIME=19:00

# Daily silent maintenance, 'HH:mm' in TIMEZONE: conversation history reset and duplicate cleanup.
# DAILY_RESET_TIME=04:00
# DAILY_DEDUP_TIME=04:10

# "¿Lo hiciste?" confirmation, answered with a 👍/👎 reaction on the notice:
#   all      = routines and the person's own reminders (default)
#   routines = routines only
#   off      = none (routines ask in text once their duration ends)
# (REMINDER_CONFIRM_POLLS is the former name and is still honored.)
REMINDER_CONFIRMATIONS=all

# ===== AI (OpenAI-compatible API) =====
# Provider: openai | openrouter | groq | deepseek | any OpenAI-compatible one
AI_PROVIDER=openai
# Model (depends on the provider), e.g. gpt-4o-mini, deepseek-chat
AI_MODEL=gpt-4o-mini
AI_API_KEY=
# Base URL of the OpenAI-compatible endpoint:
#   OpenAI:      https://api.openai.com/v1
#   OpenRouter:  https://openrouter.ai/api/v1
#   Groq:        https://api.groq.com/openai/v1
#   DeepSeek:    https://api.deepseek.com/v1
AI_BASE_URL=https://api.openai.com/v1
# How many past messages (user + bot) are re-sent as context on every call - the main driver of
# input tokens per message. Lower = cheaper, with a shorter memory of the recent conversation.
AI_HISTORY_TURNS=14

# ===== Database =====
# SQLite: a single local file, no server needed.
DB_PATH=./data/app.db

# ===== WhatsApp =====
# Baileys session name (folder inside auth_info/).
WA_SESSION=personal-agent
# Country code prepended to "local" numbers (given without it, e.g. 3001234567) when saving
# contacts or sending messages. Empty = use numbers exactly as given.
DEFAULT_COUNTRY_CODE=57
# Daily cap of PROACTIVE messages (reminders, routines, weekly report - everything sent without a
# message asking for it right then). Last line of defense against a loop sending an unusual volume
# (see backend/src/channels/whatsapp/send-guard.ts). A newly linked number starts well below this
# (automatic 14-day warm-up ramp); this is the warmed-up ceiling. 0 = unlimited.
MAX_DAILY_PROACTIVE_MESSAGES=300
# Daily cap of COLD messages (send_message to someone who never wrote to the bot) - much lower on
# purpose: it is the pattern WhatsApp watches most. Same warm-up ramp. 0 = unlimited (not advised).
MAX_DAILY_COLD_MESSAGES=20

# ===== Web portal =====
# Administrator's legacy access token, only used until the admin sets a portal password. Empty =
# generated and stored in auth_info/admin-token.txt (printed at boot).
ADMIN_TOKEN=
# Public https URL of this server. Used in WhatsApp messages that link to the portal and by Twilio
# to report each call's real status (POST /webhooks/twilio/call-status) and to fetch natural-voice
# call audio. Without it calls still happen, but their status stays at "processing".
PANEL_URL=

# ===== Audio: transcription and voice replies (100% local, no AI/tokens) =====
# Voice-note transcription (Vosk). deploy/ubuntu-04-setup-audio.sh downloads it. Missing = off
# (the bot asks for text instead).
VOSK_MODEL_PATH=./models/vosk-es
# Voice replies (Piper). Binary from https://github.com/rhasspy/piper/releases and a Spanish voice
# (.onnx + .onnx.json) from https://huggingface.co/rhasspy/piper-voices. Empty = text-only replies.
PIPER_BIN_PATH=
PIPER_VOICE_PATH=
# Optional second (female) voice - each user picks one with set_voice_gender. Empty = everyone
# uses PIPER_VOICE_PATH.
PIPER_VOICE_PATH_FEMALE=

# ===== Natural voice (Fish Audio, https://fish.audio) - paid extra =====
# Only for people with the "Voz natural (IA)" permission (voice.premium); everyone else (or when
# Fish fails) uses local Piper. Billed per character: replies longer than FISH_AUDIO_MAX_CHARS go
# out as text. Voices are fish.audio library "reference_id"s (one per gender).
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_VOICE_MALE=da13e1b3f87c4f40b8090d0fd6454921
FISH_AUDIO_VOICE_FEMALE=10509ddabaaf48089ad5cf2d1b1eaf1d
FISH_AUDIO_MAX_CHARS=700
FISH_AUDIO_TIMEOUT_MS=20000

# ===== Fashion Mode (wardrobe/outfits) =====
# Master switch. With false the bot behaves exactly as without this module.
FASHION_MODE_ENABLED=false
FASHION_MAX_IMAGE_SIZE_MB=8
# Importing several garments at once from a PDF with photos.
FASHION_MAX_PDF_SIZE_MB=15
FASHION_MAX_PDF_IMAGES=12

# DigitalOcean Spaces (S3-compatible) - stores the original garment photos + thumbnails.
DO_SPACES_ENDPOINT=https://sfo3.digitaloceanspaces.com
DO_SPACES_REGION=sfo3
DO_SPACES_BUCKET=cania-storage
DO_SPACES_ACCESS_KEY_ID=
DO_SPACES_SECRET_ACCESS_KEY=

# Local vision microservice (Python, see vision-service/ and docs/VISION_SERVICE.md) - classifies
# garment photos for free on your own server. When it is down, Fashion Mode asks to classify the
# garment by hand - it never blocks the flow.
FASHION_VISION_SERVICE_URL=http://127.0.0.1:8008
FASHION_VISION_TIMEOUT_MS=15000
FASHION_VISION_MIN_CONFIDENCE=0.35

# Vision LLM (fal.ai): with FAL_KEY set, each garment is classified by a model that actually looks
# at the photo, and what it is unsure about is asked in the portal. Without it, only the local
# classifier is used. The bot never generates images for people; the admin's "Videos y publicidad"
# uses it once per background music.
FAL_KEY=

# Videos y publicidad (admin): the recording browser is installed by deploy/ubuntu-10-setup-promo.sh.
# PROMO_BROWSER=msedge uses an installed Edge instead (development on Windows). PROMO_FPS defaults to 30.
# PROMO_BROWSER=
# PROMO_FPS=30
# FASHION_LLM_VISION_ENABLED=true
# FASHION_LLM_VISION_MODEL=google/gemini-2.5-flash

# ===== Call reminders (Twilio Programmable Voice) =====
# Twilio account credentials (console.twilio.com) - NEVER commit or log them.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio number used as caller ID for EVERY call (E.164, e.g. +18023004379).
TWILIO_PHONE_NUMBER=
# Retries for a failed/unanswered/busy call and minutes between attempts - each attempt is a real
# billed call, keep it low.
TWILIO_CALL_MAX_ATTEMPTS=3
TWILIO_CALL_RETRY_DELAY_MINUTES=5

# ===== Public sales site, free demos and analytics =====
# Public URL of the sales page (its own subdomain). Empty = only at <PANEL_URL>/conoce.
# deploy/ubuntu-08-setup-landing.sh sets it.
LANDING_URL=
# WhatsApp number (country code, digits only) behind the "Contáctanos" buttons.
CONTACT_WHATSAPP=573229457553
# Demo account duration and maximum simultaneous demos.
DEMO_HOURS=24
DEMO_MAX_ACTIVE=25
# Site verification meta tags (only the content="..." value).
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
FACEBOOK_DOMAIN_VERIFICATION=
# IndexNow key (8-128 letters/digits/dashes), e.g. the output of: openssl rand -hex 16
INDEXNOW_KEY=
# Public brand profiles, comma separated (Instagram, TikTok, Facebook, LinkedIn, YouTube...).
SOCIAL_LINKS=
# Data controller shown on /privacidad and /terminos.
LEGAL_NAME=Canix
LEGAL_ID=
LEGAL_ADDRESS=Colombia
CONTACT_EMAIL=
