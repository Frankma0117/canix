data/stickers-export/

# Built web assets: frontend/ builds the portal and the public site into /public
/public/

# Audio models/binaries, downloaded on the server (deploy/ubuntu-04-setup-audio.sh)
/models/
/bin/

# Vision microservice: Python venv + model cache, created on the server (deploy/ubuntu-05-setup-vision.sh)
vision-service/.venv/
vision-service/.cache/
vision-service/__pycache__/

