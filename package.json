{
  "name": "canix",
  "version": "0.1.0",
  "description": "Asistente personal por WhatsApp: recordatorios, links por categoria, tareas y habitos.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
