[Unit]
Description=Canix - personal assistant on WhatsApp
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=canix
WorkingDirectory=/opt/canix
# Adjust the node/npm path if you use nvm or a separately installed version
# (systemd does not load your shell profile, so PATH may not include it).
# `npm run start` at the repo root starts backend/ (see the root package.json).
ExecStart=/usr/bin/npm run start
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
