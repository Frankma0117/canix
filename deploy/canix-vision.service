[Unit]
Description=Canix - Fashion Mode vision service (CLIP, local)
After=network.target

[Service]
Type=simple
User=canix
WorkingDirectory=/opt/canix/vision-service
ExecStart=/opt/canix/vision-service/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8008
Restart=on-failure
RestartSec=5
# Lowers PyTorch's peak RAM at the cost of slightly slower inference - see "RAM usage" in
# docs/VISION_SERVICE.md before enabling Fashion Mode in production.
Environment=OMP_NUM_THREADS=1
# 'canix' is a system user (useradd -r, see ubuntu-06-setup-vision-service.sh) without a home
# folder - without this, HOME falls back to /home/canix (missing, and 'canix' cannot create it) and
# transformers fails to cache the CLIP model there (~/.cache/huggingface). Points at
# WorkingDirectory instead, which exists and already belongs to 'canix'.
Environment=HOME=/opt/canix/vision-service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
