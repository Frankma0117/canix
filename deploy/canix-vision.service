[Unit]
Description=Canix - Fashion Mode vision service (CLIP, local)
After=network.target

[Service]
Type=simple
User=canix
WorkingDirectory=/opt/canix/vision-service
ExecStart=/opt/canix/vision-service/.venv/bin/uvicorn app:app --host 127.0.0.1 --port 8008
Restart=on-failure
RestartSec=5
# Reduce el pico de RAM de PyTorch a costa de inferencia un poco mas lenta - ver la seccion
# "Uso de RAM" de vision-service/README.md antes de activar Fashion Mode en produccion.
Environment=OMP_NUM_THREADS=1
# 'canix' es un usuario de sistema (useradd -r, ver ubuntu-06-setup-vision-service.sh) sin carpeta
# home creada - sin esto, HOME cae en /home/canix (no existe, y 'canix' no puede crearla bajo
# /home) y transformers falla al intentar cachear el modelo CLIP ahi (~/.cache/huggingface).
# Se apunta a WorkingDirectory, que ya es de 'canix' (chown -R en el setup) y existe seguro.
Environment=HOME=/opt/canix/vision-service
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
