{
  "name": "canix-backend",
  "version": "0.1.0",
  "description": "Canix backend: WhatsApp assistant (Baileys + LLM agent), REST API and background jobs.",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "db:migrate": "tsx src/database/migrate.ts",
    "stickers:audit": "tsx src/scripts/audit-stickers.ts",
    "typecheck": "tsc --noEmit",
    "deadcode": "npx --yes knip@5"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1112.0",
    "@hapi/boom": "^10.0.1",
    "baileys": "7.0.0-rc14",
    "better-sqlite3": "12.11.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "ffmpeg-static": "^5.3.0",
    "multer": "^2.4.0",
    "openai": "^6.2.0",
    "pino": "^10.3.1",
    "playwright": "^1.56.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "twilio": "^6.1.0",
    "vosk-koffi": "^1.1.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.2",
    "@types/qrcode": "^1.5.5",
    "@types/qrcode-terminal": "^0.12.2",
    "tsx": "^4.19.2",
    "typescript": "^7.0.2"
  }
}
